<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sabores | Chefs</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Sabores</a>
      <nav class="section-nav" aria-label="Secciones del menú">
        <% sections.forEach((section) => { %>
          <a href="/sections/<%= section.id %>"><%= section.name %></a>
        <% }) %>
        <a class="nav-chefs active" href="/chefs">
          <img src="/chef.svg" alt="" class="chef-icon" width="18" height="18" />
        </a>
      </nav>
    </header>

    <main class="page-shell">
      <section class="intro compact-intro">
        <a class="back-link" href="/">&larr; Volver al menú</a>
        <p class="eyebrow">Equipo</p>
        <h1>Nuestros chefs</h1>
        <p>Las personas detrás de cada preparación de la carta.</p>
      </section>

      <div class="section-heading">
        <div>
          <p class="eyebrow">Cocina</p>
          <h2>Todos los chefs</h2>
        </div>
        <div class="section-heading-actions">
          <span class="result-count"><%= chefs.length %> chefs</span>
          <a class="button-primary button-with-icon" href="/chefs/new">
            Agregar chef
          </a>
        </div>
      </div>

      <% if (chefs.length) { %>
        <div class="chef-grid">
          <% chefs.forEach((chef) => { %>
            <article class="chef-card">
              <img src="<%= chef.photo %>" alt="<%= chef.name %>" loading="lazy" />
              <div class="chef-card-content">
                <h3><%= chef.name %></h3>
                <p><%= chef.description %></p>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <p class="empty-state">Todavía no hay chefs cargados.</p>
      <% } %>
    </main>
  </body>
</html>
